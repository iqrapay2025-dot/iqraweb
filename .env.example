# ------------------------------------------------------------------
# IqraPay — environment variables (copy to .env, NEVER commit .env)
# ------------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# Generate strong, unique values and keep this file in version control
# as a template (the real .env is git-ignored).

# Admin panel login (static-site mock auth — see AuthContext.tsx).
# SECURITY: there is NO backend, so these values are compiled into the public
# bundle and are recoverable from the page source. They are a convenience gate
# ONLY — not real access control. Protect the /admin route at your web host
# instead, and prefer a server-side authentication layer for anything sensitive.
# Use a long, unique, high-entropy password (never one reused elsewhere).
VITE_ADMIN_EMAIL=admin@iqrapay.com
VITE_ADMIN_PASSWORD=__replace-with-a-32+-char-random-password__

# Optional: override the waitlist Google Apps Script endpoint.
# Defaults to the value in src/config/waitlist.ts when left blank.
# VITE_WAITLIST_ENDPOINT=https://script.google.com/macros/s/.../exec

# ------------------------------------------------------------------
# Contact form & newsletter email transport (Google Apps Script).
#
# The contact & newsletter forms email iqrapay2025@gmail.com DIRECTLY via a
# small Apps Script (no API key is embedded in the client bundle — see
# src/CONTACT_FORM_SETUP.md for the script code & deploy steps). When this is
# blank, the forms fall back to a mailto:iqrapay2025@gmail.com link so a message
# is still delivered.
# ------------------------------------------------------------------
# VITE_CONTACT_ENDPOINT=https://script.google.com/macros/s/.../exec
